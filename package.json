    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-dom-server": "0.0.5",
    "react-icons": "^4.12.0",
    "remixicon": "^2.5.0",
    "sortablejs": "^1.15.6",
    "terser": "^5.39.0"
