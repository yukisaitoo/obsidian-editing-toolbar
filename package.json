  "description": "Unofficial fork of Editing Toolbar with the AI features removed. A MS Word-like editing toolbar for Obsidian. Original plugin by Cuman.",
  "main": "main.js",
  "repository": "https://github.com/yukisaitoo/obsidian-editing-toolbar",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "rollup --config rollup.config.js --environment BUILD:production",
    "deploy": "npm run build && bash deploy.sh"
  },
  "keywords": [],
  "author": "Yuki Saito",
  "license": "MPL-2.0",
  "devDependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.3",
    "@rollup/plugin-commonjs": "^18.1.0",
    "@rollup/plugin-node-resolve": "^11.2.1",
    "@rollup/plugin-typescript": "^8.5.0",
    "@types/feather-icons": "^4.29.4",
    "@types/node": "^24.13.3",
    "@types/react-dom": "^17.0.26",
    "@types/sortablejs": "^1.15.8",
    "eslint-plugin-react": "^7.37.4",
    "obsidian": "^1.13.1",
    "rollup": "^2.79.2",
    "rollup-plugin-styles": "^4.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-watch": "^4.3.1",
