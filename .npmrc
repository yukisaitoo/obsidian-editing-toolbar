# Obsidian pins exact @codemirror/* peer versions that are older than what the
# CodeMirror packages cross-require. CodeMirror is provided by Obsidian at
# runtime (marked `external` in rollup.config.mjs), so these dev deps are
# types-only and the peer conflict is harmless.
legacy-peer-deps=true

# Solo project with no CI — the lockfile is churn in every dependency bump and
# nothing consumes it. `.gitignore` ignores it; this stops npm regenerating it.
package-lock=false
