# Obsidian pins exact @codemirror/* peer versions older than what the CodeMirror
# packages cross-require. CodeMirror is provided by Obsidian at runtime (external
# in rollup.config.mjs), so these dev deps are types-only and the conflict is
# harmless.
legacy-peer-deps=true

# Solo project with no CI; nothing consumes a lockfile and .gitignore ignores it.
package-lock=false
